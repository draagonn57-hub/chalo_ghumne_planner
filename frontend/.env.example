# =============================================================
# Chalo Ghumne — Frontend Environment Variables
# Copy this file to frontend/.env and fill in real values.
# NEVER commit frontend/.env to git.
#
# All REACT_APP_ variables are embedded into the client bundle
# at build time. Do NOT put backend secrets here.
# =============================================================

# ── Backend API URL ────────────────────────────────────────
REACT_APP_BACKEND_URL=http://127.0.0.1:8000

# ── Unsplash (client-side image search) ───────────────────
# Unsplash Access Keys are designed for client-side use per
# the Unsplash API model. Restrict this key to your domain
# in the Unsplash developer dashboard.
REACT_APP_UNSPLASH_KEY=your-unsplash-access-key-here

# ── Google Maps API Key ────────────────────────────────────
# MUST be restricted to HTTP referrers (your domain only)
# in GCP Console → APIs & Services → Credentials.
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# ── Google OAuth Client ID ────────────────────────────────
# Google OAuth Client IDs are public by design for browser-
# based OAuth flows. Restrict "Authorised JavaScript origins"
# in GCP Console to your domain(s) only.
REACT_APP_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
