# =============================================================
# Chalo Ghumne — Backend Environment Variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to git.
# =============================================================

# ── MongoDB ────────────────────────────────────────────────
MONGO_URL="mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0"
DB_NAME="tour_planner"

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes).
# Used by server.py and server_2.py to restrict cross-origin requests.
ALLOWED_ORIGINS="http://localhost:3000,https://yourdomain.com"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ── Gemini AI ─────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── JWT ───────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_HOURS=168

# ── RapidAPI (Indian Railways) ────────────────────────────
RAPIDAPI_KEY=your-rapidapi-key-here
RAPIDAPI_RAILWAY_HOST=irctc-indian-railway-pnr-status.p.rapidapi.com
RAPIDAPI_RAILWAY_BASE_URL=https://irctc-indian-railway-pnr-status.p.rapidapi.com
RAPIDAPI_RAILWAY_SCHEDULE_PATH=/schedule
RAPIDAPI_RAILWAY_FARE_PATH=/fare/fare
RAPIDAPI_RAILWAY_SEARCH_PATH=/between/NDLS/KYN?date=25-12-2026

# ── SerpAPI (Google Flights) ──────────────────────────────
SERPAPI_KEY=your-serpapi-key-here

# ── Parse.bot (IRCTC scraper) ─────────────────────────────
PARSE_API_KEY=your-parse-api-key-here
PARSE_IRCTC_BASE_URL=https://api.parse.bot/scraper/your-scraper-id

# ── Google OAuth ──────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ── SMTP / Booking emails (Gmail) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourapp@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM_NAME=Chalo Ghumne
SUPPORT_EMAIL=yourapp@gmail.com
FRONTEND_BASE_URL=http://localhost:3000

# ── Resend (transactional email / OTP) ───────────────────
RESEND_API_KEY=re_your-resend-api-key-here

# ── Railkit (Indian Railways SDK) ────────────────────────
RAILKIT_API_KEY=railkit_your-railkit-api-key-here
RAILKIT_BASE_URL=https://api.railkit.in/api/v1
RAILKIT_BRIDGE_PORT=7421
RAILKIT_SEARCH_PATH=/trains/between
RAILKIT_FARE_PATH=/fare
RAILKIT_AUTH_HEADER=x-api-key

# ── Unsplash (server-side PDF watermarks) ────────────────
# Use UNSPLASH_ACCESS_KEY for backend use (not the REACT_APP_ prefix).
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here

# ── Admin seed credentials ────────────────────────────────
# Change these before running seed in any non-local environment.
ADMIN_EMAIL=admin@yourapp.com
ADMIN_PASSWORD=change-this-strong-password

# ── Environment ───────────────────────────────────────────
NODE_ENV=development
