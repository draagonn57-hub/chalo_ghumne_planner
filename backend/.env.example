# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URL=
DB_NAME=

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=

# ── Gemini (AI itinerary generation) ─────────────────────────────────────────
GEMINI_API_KEY=

# ── Parse IRCTC (train schedule + fare) ──────────────────────────────────────
PARSE_API_KEY=
PARSE_IRCTC_BASE_URL=

# ── SerpAPI (Google Flights) ──────────────────────────────────────────────────
SERPAPI_KEY=

# ── RapidAPI (deprecated — quota exhausted, kept for reference) ──────────────
# RAPIDAPI_KEY=
# RAPIDAPI_RAILWAY_HOST=
# RAPIDAPI_RAILWAY_BASE_URL=
# RAPIDAPI_RAILWAY_SEARCH_PATH=
# RAPIDAPI_RAILWAY_SCHEDULE_PATH=
# RAPIDAPI_RAILWAY_FARE_PATH=

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Gmail address used as sender. Must have 2-Step Verification enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=                        # chaloghumne.trips@gmail.com
SMTP_APP_PASSWORD=                # Gmail App Password (16 chars, strip spaces)
MAIL_FROM_NAME=Chalo Ghumne
SUPPORT_EMAIL=chaloghumne.trips@gmail.com
FRONTEND_BASE_URL=                # e.g. http://localhost:3000 or https://yourdomain.com

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=development
